{
  "name": "slopnet-push-wall",
  "target": "push",
  "enforcement": "active",
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "**/.DS_Store",
          "**/Thumbs.db",
          "**/__pycache__/**",
          "**/*.pyc",
          "**/node_modules/**",
          "**/*.log",
          ".env",
          ".env.*"
        ]
      }
    },
    {
      "type": "file_extension_restriction",
      "parameters": {
        "restricted_file_extensions": ["bak", "orig", "tmp", "swp"]
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 5
      }
    }
  ]
}
