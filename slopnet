def sh(cmd, cwd=None):
    """Run a command, return (exit_code, combined_output)."""
    proc = subprocess.run(
        cmd, cwd=cwd, capture_output=True, text=True, shell=isinstance(cmd, str),
    )
    return proc.returncode, (proc.stdout + proc.stderr).strip()


def today():
    return datetime.datetime.now().strftime("%Y-%m-%d")


def now_hm():
    return datetime.datetime.now().strftime("%H:%M")


def who_am_i(explicit=None):
    if explicit:
        return explicit
    code, name = sh(["git", "config", "user.name"])
    return name if code == 0 and name else "unknown"


def day_file(root):
    reg = root / "register"
    reg.mkdir(exist_ok=True)
    path = reg / f"{today()}.md"
    if not path.exists():
        path.write_text(f"# Register — {today()}\n", encoding="utf-8")
    return path


def git_path(root, name):
    code, path = sh(["git", "rev-parse", "--git-path", name], cwd=root)
    if code != 0:
        fail("Could not find this repository's Git files.",
             path or "git rev-parse failed.",
             "Run this from inside your project folder, or: slopnet init")
    path = pathlib.Path(path)
    return path if path.is_absolute() else root / path


def repo_is_armed(root):
    hooks = [git_path(root, f"hooks/{name}")
             for name in ("pre-commit", "post-commit")]
    hooks_ok = all(
        path.is_file() and "# slopnet-armed" in
        path.read_text(encoding="utf-8", errors="replace")
        for path in hooks
    )
    checks = root / "checks"
    checks_ok = checks.is_dir() and all(
        (checks / name).is_file() for name in ARM_CHECKS)
    return hooks_ok and checks_ok and day_file(root).exists()


def arm_from_installation(root):
    """Install the small local law set when the command runs outside its
    template checkout. Existing project files are always left untouched."""
    source = pathlib.Path(__file__).resolve().parent
    source_checks = source / "checks"
    source_hooks = source / "hooks"
    if not source_checks.is_dir() or not source_hooks.is_dir():
        fail("This SlopNet installation is missing its checks and hooks.",
             "Without them this folder cannot be armed safely.",
             "Clone a fresh copy of the SlopNet repo and run: ./install.sh")

    checks = root / "checks"
    checks.mkdir(exist_ok=True)
    for source_path in sorted(source_checks.glob("*.sh")):
        target = checks / source_path.name
        if not target.exists():
            shutil.copy2(source_path, target)

    for name in (".gitleaks.toml", "banned-names.txt", "PROTECTED.txt"):
        source_path = source / name
        target = root / name
        if source_path.exists() and not target.exists():
            shutil.copy2(source_path, target)

    hooks = git_path(root, "hooks")
    hooks.mkdir(parents=True, exist_ok=True)
    for name in ("pre-commit", "post-commit"):
        target = hooks / name
        if target.exists():
            text = target.read_text(encoding="utf-8", errors="replace")
            if "# slopnet-armed" not in text:
                fail(f"{target} already exists and is not a SlopNet hook.",
                     "It was left untouched so your hook is not overwritten.",
                     f"Move or rename {target}, then run: slopnet doctor --fix")
        else:
            shutil.copy2(source_hooks / name, target)
            target.chmod(0o755)

    exclude = git_path(root, "info/exclude")
    exclude.parent.mkdir(parents=True, exist_ok=True)
    existing = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    existing_lines = set(existing.splitlines())
    ignore_source = source / ".gitignore"
    ignore_lines = (
        ignore_source.read_text(encoding="utf-8").splitlines()
        if ignore_source.exists() else [".slopnet/"])
    missing_lines = [
        line for line in ignore_lines
        if line and not line.startswith("#") and line not in existing_lines
    ]
    if missing_lines:
        with exclude.open("a", encoding="utf-8") as handle:
            if existing and not existing.endswith("\n"):
                handle.write("\n")
            handle.write("\n".join(missing_lines) + "\n")


# ------------------------------------------------------------------ check

def run_checks(root, all_mode):
    """Run every checks/*.sh; return (ok, report_text)."""
    checks_dir = root / "checks"
    if not checks_dir.is_dir():
        return False, ("RULE: This repo has no checks/ folder.\nWHY:  Without checks there are no walls.\nFIX:  Restore them: git checkout -- checks/    or re-clone the SlopNet project")
    lines, ok = [], True
    for script in sorted(checks_dir.glob("*.sh")):
        cmd = ["sh", str(script)] + (["--all"] if all_mode else [])
        code, out = sh(cmd, cwd=root)
        if code == 0:
            lines.append(f"[OK] {script.name}")
        else:
            ok = False
            lines.append(f"[!!] {script.name}")
            lines.append(out)
    lines.append("All walls standing." if ok else "A wall said no — read its FIX line.")
    return ok, "\n".join(lines)


def cmd_check(root, args):
    ok, report = run_checks(root, args.all)
    print(report)
    sys.exit(0 if ok else 1)


# ------------------------------------------------------------------- sign

def sign_register(root, text, who):
    path = day_file(root)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(f"\n## {now_hm()} — {who} did\n\n{text.rstrip()}\n")
    return path


def cmd_sign(root, args):
    path = sign_register(root, args.text, who_am_i(args.who))
    print(f"Signed {path.relative_to(root)}.")


# ----------------------------------------------------------- session data

def pending_open_items(root):
    path = root / "register" / "PENDING_OPERATOR.md"
    if not path.exists():
        return ""
    lines, keep = [], False
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("## Open"):
            keep = True
            continue
        if line.startswith("## "):
            keep = False
        if keep and line.strip():
            lines.append(line)
    return "\n".join(lines)


def session_start_text(root):
    parts = [f"SlopNet session briefing — {today()} {now_hm()}"]
    reg = root / "register"
    days = sorted(reg.glob("????-??-??.md")) if reg.is_dir() else []
    for label, path in [("Today", days[-1] if days else None),
                        ("Previous day", days[-2] if len(days) > 1 else None)]:
        if path:
            parts.append(f"--- {label} ({path.name}) ---\n{path.read_text(encoding='utf-8').strip()}")
    open_items = pending_open_items(root)
    parts.append("--- Open questions (answer NOTHING by guessing) ---\n"
                 + (open_items if open_items else "(none)"))
    parts.append("Ritual: obey FIX lines; never rename; sign the register "
                 "before you finish (slopnet sign \"...\").")
    return "\n\n".join(parts)


def cmd_pending(root, args):
    path = root / "register" / "PENDING_OPERATOR.md"
    if not path.exists():
        path.parent.mkdir(exist_ok=True)
        path.write_text("# PENDING_OPERATOR — questions waiting for the human\n\n"
                        "## Open\n\n## Ruled\n", encoding="utf-8")
    text = path.read_text(encoding="utf-8")
    entry = f"- [{today()}, {who_am_i(args.who)}] {args.question}\n"
    marker = "## Open\n"
    if marker in text:
        text = text.replace(marker, marker + "\n" + entry, 1)
    else:
        text += f"\n## Open\n\n{entry}"
    path.write_text(text, encoding="utf-8")
    print("Question filed. Never guess instead.")


# ------------------------------------------------------------------- init

def cmd_init(root, args):
    quiet = getattr(args, "quiet", False)
    if root is None:
        code, out = sh(["git", "init"])
        if code != 0:
            fail("git init failed.",
                 out or "git printed no details.",
                 "Fix the git error above, then re-run: slopnet init")
        if not quiet:
            print("[OK] Started a fresh git repository.")
        root = repo_root()
    installer = root / "install.sh"
    if installer.exists():
        code, out = sh(["bash", str(installer)], cwd=root)
        if not quiet and out:
            print(out)
        if code != 0:
            fail("install.sh failed.",
                 "Hooks and optional tools were not fully armed.",
                 "Read the message above, fix it, then run: ./install.sh")
    else:
        arm_from_installation(root)
    day_file(root)
    if args.github:
        if shutil.which("gh") is None:
            print("[!!] --github needs the gh CLI (cli.github.com), logged in.")
        else:
            code, _ = sh(["git", "remote", "get-url", "origin"], cwd=root)
            if code != 0:
                name = root.name
                code, out = sh(["gh", "repo", "create", name, "--private",
                                "--source", str(root), "--push"], cwd=root)
                print(out if out else f"[OK] Created private repo {name} and pushed.")
            apply_sh = root / "rulesets" / "apply-rulesets.sh"
            if apply_sh.exists():
                code, out = sh(["bash", str(apply_sh)], cwd=root)
                print(out)
    doc = root / "doctor.sh"
    if doc.exists():
        code, out = sh(["bash", str(doc)], cwd=root)
        if not quiet and out:
            print(out)
    if not quiet:
        print("Armed. Your two habits: work normally, and `slopnet sign` before you stop.")
    return root


# ----------------------------------------------------------------- doctor

def cmd_doctor(root, args):
    if args.fix:
        installer = root / "install.sh"
        if installer.exists():
            code, out = sh(["bash", str(installer)], cwd=root)
            if out:
                print(out)
            if code != 0:
                fail(
                    "install.sh could not finish during doctor --fix.",
                    "Hooks or tools may still be unarmed.",
                    "Read the message above, fix it, then run: slopnet doctor --fix",
                )
        else:
            print("RULE: No install.sh in this folder.")
            print("WHY:  doctor --fix cannot re-arm hooks without it.")
            print("FIX:  cd into a full SlopNet checkout, then: slopnet doctor --fix")
        apply_sh = root / "rulesets" / "apply-rulesets.sh"
        if apply_sh.exists() and shutil.which("gh"):
            code, out = sh(["bash", str(apply_sh)], cwd=root)
            if out:
                print(out)
        elif apply_sh.exists() and not shutil.which("gh"):
            print("RULE: Branch rules were not applied automatically.")
            print("WHY:  Applying them needs the GitHub CLI (`gh`) logged in.")
            print("FIX:  Install gh, run: gh auth login")
            print("      Then re-run: slopnet doctor --fix")
            print("      Or click on GitHub, in order:")
            print("        1. Open your repo on github.com")
            print("        2. Settings")
            print("        3. Branches (or Rules → Rulesets)")
            print("        4. Require checks: law, manifest, register-audit, container")
    doc = root / "doctor.sh"
    if not doc.exists():
        fail(
            "No doctor.sh here.",
            "This folder does not look like a full SlopNet project.",
            "cd into your SlopNet project (the folder with doctor.sh), then: slopnet doctor",
        )
    code, out = sh(["bash", str(doc)], cwd=root)
    if out:
        print(out)
    needs_clicks = out and (
        "Turn on branch protection" in out
        or "Can't check from here" in out
        or "Settings → Branches" in out
    )
    if needs_clicks:
        print("")
        print("What to click on GitHub (in order):")
        print("  1. Open your repository page on github.com")
        print("  2. Click Settings")
        print("  3. Click Branches — or Rules, then Rulesets")
        print("  4. Add a rule for your default branch")
        print("  5. Require status checks: law, manifest, register-audit, container")
        print("  6. Save, then re-run: slopnet doctor")
    sys.exit(code)

# ----------------------------------------------------------------- verify

def run_verification(root, quick, who):
    """Re-run every proof; countersign the register; return (ok, report)."""
    results = []

    ok, _ = run_checks(root, all_mode=True)
    results.append(("walls (checks --all)", ok))

    if (root / "MANIFEST.sha256").exists():
        code, _ = sh("shasum -a 256 -c MANIFEST.sha256 >/dev/null 2>&1 "
                     "|| sha256sum -c MANIFEST.sha256 >/dev/null 2>&1", cwd=root)
        results.append(("machinery manifest", code == 0))

    doc = root / "doctor.sh"
    if doc.exists():
        code, _ = sh(["bash", str(doc)], cwd=root)
        results.append(("doctor", code == 0))

    redteam = root / "tests" / "redteam.sh"
    if redteam.exists() and not quick:
        code, out = sh(["bash", str(redteam)], cwd=root)
        score = next((l for l in out.splitlines() if l.startswith("SCORE:")), "no score")
        results.append((f"red-team ({score.strip()})", code == 0))
    elif quick:
        results.append(("red-team", None))  # skipped, say so honestly

    ok_all = all(ok for _, ok in results if ok is not None)
    lines = []
    for name, ok in results:
        mark = "SKIPPED (--quick)" if ok is None else ("PASS" if ok else "FAIL")
        lines.append(f"- {mark} — {name}")
    code, sha = sh(["git", "rev-parse", "--short", "HEAD"], cwd=root)
    verdict = "verified" if ok_all else "NOT verified — read the FAIL lines"
    body = (f"COUNTERSIGN at commit {sha if code == 0 else 'unknown'}:\n\n"
            + "\n".join(lines) + f"\n\nVerdict: {verdict}")

    path = day_file(root)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(f"\n## {now_hm()} — {who} countersigned\n\n{body}\n")
    return ok_all, body


def cmd_verify(root, args):
    ok, body = run_verification(root, args.quick, who_am_i(args.who))
    print(body)
    print("\nCountersign written to the register. An honest FAIL is worth "
          "more than a polite PASS.")
    sys.exit(0 if ok else 1)


# ------------------------------------------------------------------ orbit

ORBIT_README = """# {name}

One or two lines: what this idea is, in plain words.

Part of {trunk}'s SlopNet (see SLOPNET.md in the main repo).
Status: cooking
Calls: <which main-app APIs>
Last known good: {date} against main-repo commit {sha}

## Run it
<the one or two commands>
"""

ORBIT_AGENTS = """# AGENTS.md — idea-repo rules (SlopNet)

This is an experiment orbiting the {trunk} main repo. Rules:

1. Talk to the main app over HTTP only (local dev server). Never import
   its internals; never touch its files or data folders.
2. Never use production URLs, keys, or user data.
3. The operator names things. Don't rename anything.
4. Log every session in LOG.md: date — model — what changed — what's broken.
5. Keep it small enough to explain to a ten-year-old. If it stops fitting
   in your head, tell the operator instead of adding folders.
"""


def cmd_orbit(root, args):
    name = args.name
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
        fail(f"'{name}' breaks the naming law.",
             "Orbit names are one clear lowercase-hyphenated word, chosen by the operator.",
             "Pick a name the operator chose, then: slopnet orbit new that-name")
    target = root.parent / name
    if target.exists():
        fail(f"{target} already exists.",
             "Orbits are never built on top of an existing folder.",
             "Choose a new name the operator has not used, then: slopnet orbit new that-name")
    code, sha = sh(["git", "rev-parse", "--short", "HEAD"], cwd=root)
    sha = sha if code == 0 else "none"
    target.mkdir()
    (target / "README.md").write_text(
        ORBIT_README.format(name=name, trunk=root.name, date=today(), sha=sha),
        encoding="utf-8")
    (target / "AGENTS.md").write_text(
        ORBIT_AGENTS.format(trunk=root.name), encoding="utf-8")
    (target / "LOG.md").write_text(
        f"# LOG — sessions on {name}. Newest at bottom.\n", encoding="utf-8")
    for cmd in (["git", "init", "-q"], ["git", "add", "-A"],
                ["git", "commit", "-q", "-m", f"{name}: orbit born"]):
        code, out = sh(cmd, cwd=target)
        if code != 0:
            fail(f"git step failed in {target}.",
                 out or "git printed no details.",
                 f"Fix the git error above, remove {target} if it is half-made, then re-run orbit new")
    row = (f"| {name} | (local: ../{name}) | <what it is — operator fills in> "
           f"| <calls> | cooking | {today()} @ {sha} |")
    slop = root / "SLOPNET.md"
    if slop.exists():
        lines = slop.read_text(encoding="utf-8").splitlines()
        last_row = None
        for i, line in enumerate(lines):
            if line.startswith("Statuses:"):
                break
            if line.startswith("|"):
                last_row = i
        if last_row is not None:
            lines.insert(last_row + 1, row)
            slop.write_text("\n".join(lines) + "\n", encoding="utf-8")
            print(f"[OK] Registry row added to SLOPNET.md.")
        else:
            print(f"[??] Couldn't find the registry table; add this row yourself:\n{row}")
    print(f"[OK] Orbit '{name}' born at {target}. Build wild — the trunk can't feel it.")


# ------------------------------------------------------------------ adapt

def mcp_snippet(root):
    return json.dumps({
        "mcpServers": {
            "slopnet": {
                "command": "python3",
                "args": [str(root / "slopnet"), "mcp"],
            }
        }
    }, indent=2)


def cmd_adapt(root, args):
    found = []
    for tool, marker in [("Claude Code", ".claude"), ("Cursor", ".cursor"),
                         ("VS Code", ".vscode"), ("Gemini CLI", ".gemini")]:
        if (root / marker).exists():
            found.append(tool)
    for exe in ("claude", "cursor", "codex", "gemini", "hermes"):
        if shutil.which(exe) and exe not in [f.lower() for f in found]:
            found.append(f"{exe} (on PATH)")
    print("Tools detected: " + (", ".join(found) if found else "none yet") + "\n")

    adapter = root / "adapters" / "claude-code"
    claude_dir = root / ".claude"
    if adapter.is_dir() and not claude_dir.exists():
        shutil.copytree(adapter, claude_dir)
        print("[OK] Claude Code adapter installed to .claude/ "
              "(prompt auto-logging + protected-path guard + session skill).")
    elif claude_dir.exists():
        print("[OK] .claude/ already present — leaving it alone.")

    print("\nFor ANY MCP-capable tool (Cursor, Codex, Gemini CLI, VS Code, "
          "Hermes…), give it this server config:\n")
    print(mcp_snippet(root))
    print("\nThat single server is the universal adapter — session briefing, "
          "register signing, and the walls, callable from inside the tool.")


# ------------------------------------------------------------------- crew

def load_crew_module(root):
    """crew.py lives beside this file; import it without needing a package."""
    import importlib.util
    path = pathlib.Path(__file__).resolve().parent / "crew.py"
    if not path.exists():
        fail("crew.py is missing.",
             "This checkout is incomplete; the crew cannot run.",
             "Restore crew.py from git: git checkout -- crew.py")
    spec = importlib.util.spec_from_file_location("slopnet_crew", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def ask_operator(question, options, multi=False):
    """Plain-language prompt. Returns an index, or a list of indexes."""
    default = " [1]" if options is not None else ""
    print(f"\n{question}{default}")
    if options is None:
        return input("> ").strip()
    for i, option in enumerate(options, start=1):
        print(f"  {i}. {option}")
    while True:
        raw = input("> ").strip()
        if not raw:
            return [0] if multi else 0
        try:
            picks = [int(p) - 1 for p in raw.replace(" ", "").split(",") if p]
        except ValueError:
            picks = []
        if picks and all(0 <= p < len(options) for p in picks):
            return picks if multi else picks[0]
        print("Type the number(s) you want, like: 1" + (" or 1,2" if multi else ""))


def cmd_setup(root, args):
