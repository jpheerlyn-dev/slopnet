# ---------------------------------------------------------------- helpers

def repo_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        fail("git is not installed.",
             "SlopNet needs git to track your project.",
             "Install git, then re-run this command. On a Mac: xcode-select --install")
    if out.returncode != 0:
        return None
    return pathlib.Path(out.stdout.strip())


def fail(rule, why, fix, code=1):
    """Three short lines: what happened, why it matters, what to type next."""
    print(f"RULE: {rule}")
    print(f"WHY:  {why}")
    print(f"FIX:  {fix}")
    sys.exit(code)


def die(msg, code=1):
    """Print a structured failure. Prefer fail(rule, why, fix) at call sites."""
    text = str(msg).strip()
    if text.startswith("RULE:"):
        print(text)
        sys.exit(code)
    # Known short crew messages keep a machine-stable str(exc) for tests,
    # but users still get RULE/WHY/FIX here.
    known = {
        "agent timed out": (
            "The coding app did not finish in time.",
            "Retry, or raise the timeout in .slopnet/crew.json, then re-run",
        ),
        "not logged in": (
            "This agent has no usable login or API key.",
            "Log the AI app in (or export its key), then: slopnet setup",
        ),
    }
    for key, (why_k, fix_k) in known.items():
        if key in text.lower():
            print(f"RULE: {text}")
            print(f"WHY:  {why_k}")
            print(f"FIX:  {fix_k}")
            sys.exit(code)
    lines = [ln for ln in text.splitlines() if ln.strip()]
    rule = lines[0] if lines else "Something went wrong."
    why = lines[1] if len(lines) > 1 else "SlopNet stopped so nothing unsafe continues."
    if why.startswith("WHY:"):
        why = why[4:].strip()
    fix = None
    for ln in lines[2:]:
        if ln.startswith("FIX:"):
            fix = ln[4:].strip()
            break
    if fix is None:
        fix = "Fix the cause above, then re-run the same command."
    print(f"RULE: {rule}")
    print(f"WHY:  {why}")
    print(f"FIX:  {fix}")
    sys.exit(code)


def require_python():
    if sys.version_info < (3, 9):
        fail(
            f"Python {sys.version_info.major}.{sys.version_info.minor} is too old.",
            "SlopNet needs Python 3.9 or newer.",
            "Install a newer Python from python.org or your package manager, "
            "then run: python3 --version",
        )


